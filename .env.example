# ============================================================================
#  환경 변수 예시 파일
#
#  쓰는 방법 (VS Code 터미널에서) :
#     Copy-Item .env.example .env
#
#  왜 .env 는 깃허브에 올리지 않나요?
#    .env 에는 사람마다 다른 값이나 비밀 값이 들어갈 수 있습니다.
#    그래서 .gitignore 로 .env 를 막고, '예시 파일'만 올립니다.
#    이 예시 파일에는 비밀번호나 토큰을 절대 적지 않습니다.
# ============================================================================

# 실행 환경 이름 (dev / stage / prod 처럼 씁니다)
APP_ENV=dev

# 화면/응답에 보여 줄 인사말
APP_MESSAGE=Hello Compose!
