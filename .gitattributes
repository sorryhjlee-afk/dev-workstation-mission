# 줄바꿈 문자 통일
# 리눅스(컨테이너) 안에서 실행되는 셸 스크립트는 반드시 LF 여야 한다.
# CRLF 로 내려받으면 bash 가 "\r: command not found" 로 실패한다.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf

# 윈도우 터미널에 복사해 쓰는 명령 모음은 CRLF 가 편하다
*.txt       text eol=crlf

# 이미지 등 바이너리는 건드리지 않는다
*.png binary
*.jpg binary

*.yml       text eol=lf
*.yaml      text eol=lf
*.template  text eol=lf
